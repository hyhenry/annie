# ─────────────────────────────────────────────────────────────────────────────
# Annie — Stock Recommendation Engine
# Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
#
# HOW TO USE:
#   1. Copy this file: cp .env.example .env
#   2. Fill in your values (especially TAAPI_SECRET)
#   3. Never commit your .env file to version control!
#
# To get a TAAPI secret key: sign up at https://taapi.io
# The free tier is enough to test — no credit card required.
# ─────────────────────────────────────────────────────────────────────────────

# Your TAAPI.io API secret key (required for live data, not needed in mock mode)
TAAPI_SECRET=your_taapi_api_key_here

# Run with built-in sample data instead of calling TAAPI (true/false)
# Set to true to test the engine without any API key
MOCK_MODE=false

# Set to true only if you have a TAAPI Pro plan (enables faster bulk endpoint)
USE_BULK_API=false

# TAAPI exchange identifier for US stocks
TAAPI_EXCHANGE=stocks

# ─── Risk Management ──────────────────────────────────────────────────────────
# How many dollars to risk per trade (stop-loss distance × shares = this amount)
# Professional rule: risk no more than 1-2% of your account per trade.
# Example: $500 risk on a $50,000 account = 1% risk per trade.
RISK_PER_TRADE_USD=500.0
ACCOUNT_SIZE_USD=50000.0

# ─── Hard Filters (auto-Avoid thresholds) ─────────────────────────────────────
# Stocks below this price are ignored (penny stocks)
MIN_PRICE=5.0

# Stocks with fewer than this many daily shares traded are ignored
MIN_AVG_VOLUME=500000

# Stocks where ATR > this % of price are ignored (too volatile to manage)
MAX_ATR_PCT=0.08

# ─── ATR-based Trade Plan Multipliers ─────────────────────────────────────────
# Stop loss placed this many ATRs below entry price
ATR_STOP_MULTIPLIER=1.5

# Take-profit placed this many ATRs above entry price (relative to stop)
ATR_TP_MULTIPLIER=2.5

# ─── Logging ──────────────────────────────────────────────────────────────────
# Log verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
